{
  "name": "vagalume",
  "version": "0.1.0",
  "private": true,
  "description": "App desktop que varre o LinkedIn, filtra as vagas que valem a pena e dá nota de match com o seu currículo",
  "main": "./out/main/index.js",
  "author": "Kevin Lopes",
  "license": "ISC",
  "homepage": "https://github.com/KevinLopes23/linkedin-job-bot",
  "repository": {
    "type": "git",
    "url": "https://github.com/KevinLopes23/linkedin-job-bot.git"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "node tools/lint/node_modules/eslint/bin/eslint.js .",
    "test": "vitest run",
    "test:watch": "vitest",
    "dist": "electron-vite build && electron-builder --win",
    "postinstall": "npm --prefix tools/lint install --no-audit --no-fund"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@google/genai": "^3.1.0",
    "cheerio": "^1.0.0",
    "playwright-core": "^1.65.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "unpdf": "^2.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.3.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  }
}
